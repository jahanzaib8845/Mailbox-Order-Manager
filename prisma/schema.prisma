generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Provider {
  GOOGLE
  MICROSOFT
}

enum OrderStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
}

enum MailboxStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Order {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  domain         String
  provider       Provider
  mailboxCount   Int
  status         OrderStatus       @default(PENDING)
  idempotencyKey String?           @unique
  mailboxes      Mailbox[]
  history        OrderStatusHistory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider])
}

model Mailbox {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  index     Int
  email     String?
  status    MailboxStatus @default(PENDING)
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([orderId, index])
  @@index([orderId])
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actorRole  Role?
  reason     String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
}
